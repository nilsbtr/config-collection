{
  // ----- System -----
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  "auto_install_extensions": {
    "ruff": true,
    "oxc": true,
    "zedokai": true,
    "soft-charmed-icons": true,
    "tailwindcss": true,
    "python-requirements": true
  },

  // ----- Appearance -----
  "theme": "Zedokai",
  "icon_theme": "Soft Charmed Icons",
  "ui_font_size": 16,
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "buffer_font_size": 14,
  "buffer_font_features": { "calt": false, "liga": false, "dliga": false },

  // ----- Panels / docks -----
  "agent": { "dock": "right" },
  "collaboration_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "git_panel": { "dock": "left", "tree_view": true, "group_by": "staging" },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "indent_size": 8
  },

  // ----- Editor -----
  "base_keymap": "VSCode",
  "current_line_highlight": "gutter",
  "edit_predictions": { "provider": "copilot" },
  "indent_guides": { "enabled": true, "coloring": "indent_aware" },
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false
    }
  },
  "minimap": { "show": "auto" },
  "scroll_beyond_last_line": "off",
  "show_whitespaces": "all",
  "snippet_sort_order": "top",
  "tab_size": 2,
  "use_on_type_format": false,
  "wrap_guides": [100],

  // ----- Files -----
  "autosave": "on_window_change",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "formatter": "auto",
  "format_on_save": "on",
  "file_scan_exclusions": [
    // Defaults
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",

    // Python
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/__pycache__",
    "**/.tox",
    "**/.nox",
    "**/.hypothesis",
    "**/*.egg-info",
    "**/.ipynb_checkpoints",
    "**/.venv",
    "**/venv",

    // JS/React
    "**/node_modules",
    "**/.next",
    "**/.vite",
    "**/.astro",
    "**/dist",
    "**/build",
    "**/out",
    "**/.turbo",
    "**/.pnpm-store",
    "**/.vercel",
    "**/.wrangler",
    "**/coverage",
    "**/playwright-report",
    "**/test-results"
  ],
  "file_types": {
    "Jinja2": ["*.j2", "*.jinja", "*.jinja2"],
    "JSONC": [".vscode/*.json"]
  },

  // ----- Terminal -----
  "terminal": {
    "shell": { "program": "pwsh" },
    "font_family": "GeistMono Nerd Font Mono",
    "font_size": 14,
    "font_features": { "calt": false, "liga": false, "dliga": false },
    "blinking": "on",
    "cursor_shape": "bar",
    "max_scroll_history_lines": 10000,
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", ".env", "env"],
        "activate_script": "default"
      }
    }
  },

  // ----- LSP -----
  "lsp": {
    "ty": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "configurationPreference": "filesystemFirst",
          "lint": { "enable": true }
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
          "typeAware": true
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": { "importModuleSpecifier": "non-relative" }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": ["cn\\(([^)]*)\\)", "clsx\\(([^)]*)\\)", "cva\\(([^)]*)\\)"]
        }
      }
    }
  },

  // ----- Languages -----
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "formatter": [{ "language_server": { "name": "ruff" } }],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      },
      "tab_size": 4
    },
    "JavaScript": {
      "language_servers": ["vtsls", "oxlint"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TypeScript": {
      "language_servers": ["vtsls", "oxlint"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": ["vtsls", "oxlint"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JSON": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}
