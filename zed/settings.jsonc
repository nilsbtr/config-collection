{
    // ----- System -----
    "telemetry": { "diagnostics": true, "metrics": false },
    "auto_update": false,
    "cli_default_open_behavior": "existing_window",
    "auto_install_extensions": {
        "charmed-icons": true,
        "csv": true,
        "dockerfile": true,
        "env": true,
        "git-firefly": true,
        "html": true,
        "jinja2": true,
        "json5": true,
        "just": true,
        "mermaid": true,
        "oxc": true,
        "powershell": true,
        "python-requirements": true,
        "python-snippets": true,
        "react-typescript-snippets": true,
        "sql": true,
        "toml": true,
        "xml": true,
        "zedokai": true,
    },

    // ----- Appearance -----
    "theme": "Zedokai",
    "icon_theme": "Soft Charmed Icons",
    "ui_font_size": 16,
    "buffer_font_family": "GeistMono Nerd Font Mono",
    "buffer_font_size": 14,
    "buffer_font_features": { "calt": false, "liga": false, "dliga": false },
    "title_bar": { "show_user_picture": false },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "status_bar": { "cursor_position_button": false },

    // ----- Panels / docks -----
    "project_panel": {
        "dock": "left",
        "hide_root": true,
        "auto_fold_dirs": false,
        "entry_spacing": "standard",
        "indent_guides": { "show": "never" },
        "indent_size": 8,
        "sticky_scroll": false,
    },
    "git_panel": {
        "dock": "left",
        "commit_title_max_length": 50,
        "tree_view": true,
        "group_by": "staging",
    },
    "outline_panel": { "dock": "left" },
    "collaboration_panel": { "dock": "left", "button": false },
    "agent": {
        "dock": "right",
        "sidebar_side": "right",
        "enable_feedback": false,
        "show_turn_stats": true,
        "thinking_display": "preview",
        "use_modifier_to_send": true,
    },
    "active_pane_modifiers": { "inactive_opacity": 0.75 },

    // ----- Editor -----
    "base_keymap": "VSCode",
    "use_on_type_format": false,
    "snippet_sort_order": "top",
    "tab_size": 4,
    "soft_wrap": "none",
    "wrap_guides": [100],
    "show_whitespaces": "all",
    "current_line_highlight": "gutter",
    "minimap": { "show": "auto" },
    "inlay_hints": {
        "enabled": false,
        "show_value_hints": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "toggle_on_modifiers_press": { "alt": true },
    },
    "scroll_beyond_last_line": "off",
    "tabs": { "git_status": true, "show_diagnostics": "all" },
    "preview_tabs": { "enable_keep_preview_on_code_navigation": true },
    "use_smartcase_search": true,

    // ----- Git -----
    "diff_view_style": "unified",
    "git": { "inline_blame": { "show_commit_summary": true } },

    // ----- Files -----
    "autosave": { "after_delay": { "milliseconds": 1000 } },
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "formatter": "auto",
    "format_on_save": "on",
    "file_scan_exclusions": [
        // Defaults
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",

        // Python
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/__pycache__",
        "**/.tox",
        "**/.nox",
        "**/.hypothesis",
        "**/*.egg-info",
        "**/.ipynb_checkpoints",
        "**/.venv",
        "**/venv",

        // JS/React
        "**/node_modules",
        "**/.next",
        "**/.vite",
        "**/.astro",
        "**/dist",
        "**/build",
        "**/out",
        "**/.turbo",
        "**/.pnpm-store",
        "**/.vercel",
        "**/.wrangler",
        "**/coverage",
        "**/playwright-report",
        "**/test-results",
    ],
    "file_types": {
        "Jinja2": ["*.j2", "*.jinja", "*.jinja2"],
        "JSONC": [".vscode/*.json"],
    },

    // ----- Terminal -----
    "terminal": {
        "shell": { "program": "pwsh" },
        "font_family": "GeistMono Nerd Font Mono",
        "font_size": 14,
        "font_features": { "calt": false, "liga": false, "dliga": false },
        "blinking": "on",
        "cursor_shape": "bar",
        "max_scroll_history_lines": 10000,
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv", ".env", "env"],
                "activate_script": "default",
            },
        },
    },

    // AI
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
        "opencode": {
            "default_config_options": {
                "mode": "build",
                "effort": "max",
                "model": "opencode/x-preview-f-free",
            },
            "type": "registry",
        },
    },
    "edit_predictions": {
        "allow_data_collection": "no",
        "provider": "copilot",
        "copilot": { "enable_next_edit_suggestions": false },
    },

    // ----- LSP -----
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": { "enabled": "always" },
                },
                "javascript": {
                    "updateImportsOnFileMove": { "enabled": "always" },
                },
            },
            "enable_lsp_tasks": true,
        },
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "configPath": null,
                    "run": "onType",
                    "disableNestedConfig": false,
                    "fixKind": "safe_fix",
                    "unusedDisableDirectives": "deny",
                    "typeAware": true,
                },
            },
        },
        "ty": {
            "settings": {
                "python": {
                    "pythonPath": ".venv/bin/python",
                },
            },
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    "configurationPreference": "filesystemFirst",
                    "lint": { "enable": true },
                },
            },
        },
        "tailwindcss-language-server": {
            "settings": {
                "experimental": {
                    "classRegex": [
                        "cn\\(([^)]*)\\)",
                        "clsx\\(([^)]*)\\)",
                        "cva\\(([^)]*)\\)",
                    ],
                },
            },
        },
    },
}
